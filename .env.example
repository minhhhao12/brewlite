# Biến dùng cho Docker Compose ở local. KHÔNG dùng các giá trị này ở production.
# API và Web có file .env.example riêng trong apps/api và apps/web.

POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite_local_only
POSTGRES_DB=brewlite
POSTGRES_PORT=5432

API_PORT=3000
WEB_PORT=3001

# Secret JWT chỉ dùng cho local. Production đặt trên Render, không dùng giá trị này.
JWT_SECRET=local-only-jwt-secret-at-least-32-characters

# Đơn PENDING/PAYMENT_FAILED quá số giây này sẽ bị hủy tự động theo cơ chế lazy expiry.
ORDER_PAYMENT_TIMEOUT_SECONDS=900

# Đổi thành vnpay và điền thông tin được cấp trong .env (không commit secret).
# đổi payment_provider ở đây (mock || vnpay), sau khi đổi chạy lệnh docker compose up -d --force-recreate api
# Code xem trên Zalo
PAYMENT_PROVIDER=mock
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

VNPAY_RETURN_URL=http://localhost:3000/payments/vnpay/return
WEB_BASE_URL=http://localhost:3001
