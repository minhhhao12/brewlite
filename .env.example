# Biến dùng cho docker-compose ở local. KHÔNG dùng giá trị này ở production.
# API và Web có file .env.example riêng trong apps/api và apps/web.
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite_local_only
POSTGRES_DB=brewlite
POSTGRES_PORT=5432
API_PORT=3000
WEB_PORT=3001
# Secret JWT chỉ dùng cho local. Production đặt trên Render, không dùng giá trị này.
JWT_SECRET=local-only-jwt-secret-at-least-32-characters
