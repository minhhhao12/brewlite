// BrewLite – Prisma schema
// Hybrid Inventory
// - Product có công thức: quản lý tồn kho bằng Ingredient.
// - Product không có công thức: quản lý tồn kho bằng Product.stock.
// - Size/Topping có thể thay đổi lượng nguyên liệu tiêu thụ.
// - OrderIngredientUsage và OrderProductStockUsage lưu snapshot để hoàn kho chính xác.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
}

enum ProductStatus {
  ACTIVE
  HIDDEN
}

enum OptionType {
  SIZE
  TOPPING
}

enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  INITIATED
  PAID
  FAILED
}

// Lý do hủy đơn: khách tự hủy, nhân viên hủy hoặc hệ thống tự hủy do quá hạn thanh toán.
enum CancelReason {
  CUSTOMER
  STAFF
  SYSTEM_EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PromotionStatus {
  ACTIVE
  INACTIVE
}

enum LoyaltyType {
  EARN
  REVERSAL
}

model User {
  userId        String   @id @default(uuid()) @db.Uuid
  username      String   @db.VarChar(50)
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @db.VarChar(255)
  role          UserRole @default(CUSTOMER)
  isActive      Boolean  @default(true)
  loyaltyPoints Int      @default(0)

  orders              Order[]
  payments            Payment[]
  loyaltyTransactions LoyaltyTransaction[]

  @@index([role])
}

model Product {
  productId   String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(120)
  description String        @db.Text
  basePrice   Decimal       @db.Decimal(12, 2)
  imageUrl    String        @db.VarChar(500)
  // Chỉ dùng cho món không có công thức; món có công thức quản lý bằng Ingredient.stock.
  // Trừ Product.stock kết hợp optimistic locking (version) và điều kiện stock >= qty.
  stock       Int           @default(0)
  version     Int           @default(0)
  status      ProductStatus @default(ACTIVE)

  options            ProductOption[]
  orderItems         OrderItem[]
  ingredients        ProductIngredient[]
  productStockUsages OrderProductStockUsage[]

  @@index([status])
  @@index([name])
}

model ProductOption {
  optionId        String     @id @default(uuid()) @db.Uuid
  productId       String     @db.Uuid
  name            String     @db.VarChar(60)
  type            OptionType
  priceAdjustment Decimal    @default(0) @db.Decimal(12, 2)
  isAvailable     Boolean    @default(true)

  product           Product                   @relation(fields: [productId], references: [productId], onDelete: Cascade)
  ingredientEffects ProductOptionIngredient[]

  @@unique([productId, name, type])
  @@index([productId])
}

model ProductOptionIngredient {
  optionId      String  @db.Uuid
  ingredientId  String  @db.Uuid
  quantityDelta Decimal @db.Decimal(12, 3)

  option     ProductOption @relation(fields: [optionId], references: [optionId], onDelete: Cascade)
  ingredient Ingredient    @relation(fields: [ingredientId], references: [ingredientId], onDelete: Restrict)

  @@id([optionId, ingredientId])
  @@index([ingredientId])
}

model Order {
  orderId        String      @id @default(uuid()) @db.Uuid
  orderCode      String      @unique @db.VarChar(32)
  userId         String      @db.Uuid
  promotionId    String?     @db.Uuid
  subtotal       Decimal     @db.Decimal(12, 2)
  discountAmount Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal     @db.Decimal(12, 2)
  status         OrderStatus @default(PENDING)
  createdAt      DateTime    @default(now())

  // Thông tin hủy đơn: ai hủy và khi nào. Hệ thống tự hủy do quá hạn thanh toán
  // dùng cancelReason = SYSTEM_EXPIRED và cancelledBy = null.
  cancelReason CancelReason?
  cancelledAt  DateTime?
  cancelledBy  String?       @db.Uuid

  user                User                     @relation(fields: [userId], references: [userId], onDelete: Restrict)
  promotion           Promotion?               @relation(fields: [promotionId], references: [promotionId], onDelete: SetNull)
  items               OrderItem[]
  payments            Payment[]
  loyaltyTransactions LoyaltyTransaction[]
  ingredientUsages    OrderIngredientUsage[]
  productStockUsages  OrderProductStockUsage[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([promotionId])
}

model OrderItem {
  orderItemId String  @id @default(uuid()) @db.Uuid
  orderId     String  @db.Uuid
  productId   String  @db.Uuid
  productName String  @db.VarChar(120)
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  order   Order             @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product Product           @relation(fields: [productId], references: [productId], onDelete: Restrict)
  options OrderItemOption[]

  @@index([orderId])
  @@index([productId])
}

// Snapshot tên/giá option tại thời điểm đặt đơn.
model OrderItemOption {
  orderItemOptionId String     @id @default(uuid()) @db.Uuid
  orderItemId       String     @db.Uuid
  optionName        String     @db.VarChar(60)
  optionType        OptionType
  priceAdjustment   Decimal    @db.Decimal(12, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [orderItemId], onDelete: Cascade)

  @@index([orderItemId])
}

model Payment {
  paymentId            String        @id @default(uuid()) @db.Uuid
  userId               String        @db.Uuid
  orderId              String        @db.Uuid
  idempotencyKey       String        @db.VarChar(64)
  amount               Decimal       @db.Decimal(12, 2)
  method               PaymentMethod
  status               PaymentStatus @default(INITIATED)
  transactionReference String?       @db.VarChar(128)
  createdAt            DateTime      @default(now())

  user  User  @relation(fields: [userId], references: [userId], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [orderId], onDelete: Restrict)

  // Chốt chặn cuối cùng cho retry đồng thời cùng một lần thanh toán.
  @@unique([userId, orderId, idempotencyKey])
  @@index([orderId, status])
  @@index([userId, createdAt])
}

model Promotion {
  promotionId        String          @id @default(uuid()) @db.Uuid
  code               String          @unique @db.VarChar(32)
  discountType       DiscountType
  discountValue      Decimal         @db.Decimal(12, 2)
  maxDiscount        Decimal?        @db.Decimal(12, 2)
  minimumOrderAmount Decimal         @default(0) @db.Decimal(12, 2)
  startAt            DateTime
  endAt              DateTime
  status             PromotionStatus @default(ACTIVE)

  orders Order[]

  @@index([status, startAt, endAt])
}

model LoyaltyTransaction {
  transactionId String      @id @default(uuid()) @db.Uuid
  userId        String      @db.Uuid
  orderId       String      @db.Uuid
  points        Int
  type          LoyaltyType
  createdAt     DateTime    @default(now())

  user  User  @relation(fields: [userId], references: [userId], onDelete: Restrict)
  order Order @relation(fields: [orderId], references: [orderId], onDelete: Restrict)

  // Mỗi đơn tối đa một EARN và một REVERSAL (FR-10).
  @@unique([orderId, type])
  @@index([userId, createdAt])
}

// Nguyên liệu
model Ingredient {
  ingredientId String  @id @default(uuid()) @db.Uuid
  name         String  @unique @db.VarChar(80)
  unit         String  @db.VarChar(20)
  stock        Decimal @default(0) @db.Decimal(12, 3)

  recipes       ProductIngredient[]
  usages        OrderIngredientUsage[]
  optionEffects ProductOptionIngredient[]
}

// Công thức nguyên liệu của sản phẩm
model ProductIngredient {
  productId          String  @db.Uuid
  ingredientId       String  @db.Uuid
  quantityPerServing Decimal @db.Decimal(12, 3)

  product    Product    @relation(fields: [productId], references: [productId], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [ingredientId], onDelete: Restrict)

  @@id([productId, ingredientId])
  @@index([ingredientId])
}

// Snapshot nguyên liệu đã tiêu thụ khi tạo đơn.
// Decimal để lưu chính xác đến 3 chữ số thập phân.
model OrderIngredientUsage {
  orderId      String  @db.Uuid
  ingredientId String  @db.Uuid
  quantity     Decimal @db.Decimal(12, 3)

  order      Order      @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [ingredientId], onDelete: Restrict)

  @@id([orderId, ingredientId])
  @@index([ingredientId])
}

// Snapshot số lượng Product.stock đã trừ khi tạo đơn.
// Dùng để hoàn kho đúng số lượng khi hủy đơn.
model OrderProductStockUsage {
  orderId   String @db.Uuid
  productId String @db.Uuid
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [productId], onDelete: Restrict)

  @@id([orderId, productId])
  @@index([productId])
}
