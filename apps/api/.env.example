# API – copy thành apps/api/.env khi chạy local. KHÔNG commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL local (docker-compose) hoặc Render Internal Database URL ở production.
DATABASE_URL=postgresql://brewlite:brewlite_local_only@localhost:5432/brewlite?schema=public

# Origin của Next.js, nhiều origin cách nhau bởi dấu phẩy.
CORS_ORIGIN=http://localhost:3001

# Bắt buộc khi API khởi động (env validation); dùng cho auth ở Sprint 2. Tối thiểu 32 ký tự.
JWT_SECRET=replace-with-a-random-value-at-least-32-characters
JWT_EXPIRES_IN=1h

# Thanh toán mô phỏng – không phải cổng thật.
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_DELAY_MS=300
PAYMENT_MOCK_FAILURE_RATE=0

# Chạy `prisma migrate deploy` khi container khởi động (xem docker-entrypoint.sh).
RUN_MIGRATIONS=true
