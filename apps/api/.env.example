NODE_ENV=development
PORT=3000

# PostgreSQL chạy bằng docker compose ở root repository
DATABASE_URL=postgresql://brewlite:brewlite_local_only@127.0.0.1:5432/brewlite?schema=public

# Tối thiểu 32 ký tự. Production phải dùng secret riêng, không dùng giá trị local.
JWT_SECRET=local-only-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=1h

CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
LOG_LEVEL=info

# Mock payment (ADR-005)
PAYMENT_PROVIDER=mock
PAYMENT_MOCK_DELAY_MS=300
PAYMENT_MOCK_FAILURE_RATE=0
PAYMENT_MOCK_TIMEOUT_RATE=0

RUN_MIGRATIONS=false
