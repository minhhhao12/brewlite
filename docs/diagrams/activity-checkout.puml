@startuml
title Activity Diagram – Luồng đặt hàng và thanh toán (BrewLite)

|Khách hàng|
start
:Thêm sản phẩm vào giỏ hàng;
:Nhấn "Đặt hàng";

|Hệ thống|
if (Đã đăng nhập (JWT hợp lệ)?) then (chưa)
  |Khách hàng|
  :Đăng nhập;
  |Hệ thống|
else (rồi)
endif

:Kiểm tra tồn kho;
if (Còn đủ hàng?) then (hết hàng)
  :Thông báo sản phẩm hết hàng;
  |Khách hàng|
  :Xem thông báo, chỉnh sửa giỏ hàng;
  stop
else (còn hàng)
endif

|Hệ thống|
:Tạo đơn hàng (PENDING) và trừ tồn kho\n(trong một transaction);

repeat
  |Khách hàng|
  :Chọn phương thức thanh toán;
  :Nhấn "Xác nhận thanh toán";

  |Hệ thống|
  :Tạo Idempotency-Key, gửi POST /payments;
  :Kiểm tra JWT, quyền sở hữu,\ntrạng thái và số tiền đơn hàng;

  if (Hợp lệ?) then (không)
    :Trả lỗi 401 / 403 / 409;
    |Khách hàng|
    :Xem thông báo lỗi;
    stop
  else (có)
  endif

  |Hệ thống|
  if (Idempotency-Key đã tồn tại?) then (có)
    :Trả kết quả đã lưu\nhoặc "đang xử lý";
    |Khách hàng|
    :Xem kết quả;
    stop
  else (chưa)
  endif

  |Hệ thống|
  :Lưu Payment = PROCESSING;

  |Payment Service|
  :Xử lý thanh toán mô phỏng;

  |Hệ thống|
  if (Thanh toán thành công?) then (có)
    :Payment = PAID, Order = PAID;
  else (không)
    if (Kết quả đã xác minh?) then (thất bại)
      :Payment = FAILED, Order = PAYMENT_FAILED;
    else (timeout)
      :Giữ Payment = PROCESSING, Order = PENDING;
    endif
  endif

  |Khách hàng|
  :Nhận thông báo kết quả\n(thành công / thất bại / đang xác minh);

repeat while (Thất bại và khách hàng thử lại\n(Idempotency-Key mới, đơn cũ)?) is (có) not (không)
stop
@enduml
