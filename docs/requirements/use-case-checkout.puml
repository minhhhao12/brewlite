@startuml
' Use case trọng tâm: UC-08 Thanh toán đơn hàng
left to right direction
skinparam packageStyle rectangle
skinparam ranksep 80
skinparam nodesep 30

actor "Khách hàng" as Customer
actor "Cổng thanh toán\n(Mock Payment Gateway)" as PaymentGateway

rectangle "BrewLite System" {
  usecase "Thanh toán đơn hàng\n(UC-08)" as UC_08

  ' --- include: bước bắt buộc ---
  usecase "Xác thực JWT & kiểm tra\nquyền sở hữu đơn hàng" as UC_08c
  usecase "Chọn phương thức thanh toán\n(Ví điện tử / Thẻ ngân hàng)" as UC_08b
  usecase "Thanh toán online\n(gửi yêu cầu, nhận kết quả)" as UC_08a

  ' --- extend: tùy chọn / ngoại lệ ---
  usecase "Thanh toán lại đơn hàng\n(khi PAYMENT_FAILED)" as UC_08d
}

Customer --> UC_08

UC_08 ..> UC_08c : <<include>>
UC_08 ..> UC_08b : <<include>>
UC_08 ..> UC_08a : <<include>>

UC_08d .up.> UC_08 : <<extend>>

UC_08a --> PaymentGateway
@enduml
