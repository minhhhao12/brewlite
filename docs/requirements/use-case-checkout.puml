@startuml
left to right direction


actor "Khách hàng" as Customer
actor "Cổng thanh toán" as PaymentGateway

rectangle "Hệ thống BrewLite - Thanh toán đơn hàng" {

    usecase "Thanh toán đơn hàng" as UC9

    usecase "Áp dụng mã\nkhuyến mãi" as UCPromo

    usecase "Xử lý thanh toán\nonline" as UCOnline

    usecase "Kiểm tra đơn hàng\nvà quyền sở hữu" as UCValidate

    usecase "Kiểm tra khóa\nIdempotency" as UCIdempotency

    usecase "Ghi nhận thanh toán\nvà cập nhật trạng thái" as UCRecord

    usecase "Thông báo kết quả\nthanh toán" as UCResult
}

Customer --> UC9

UCPromo ..> UC9 : <<extend>>

UC9 ..> UCValidate : <<include>>
UC9 ..> UCIdempotency : <<include>>
UC9 ..> UCOnline : <<include>>
UC9 ..> UCRecord : <<include>>
UC9 ..> UCResult : <<include>>

UCOnline --> PaymentGateway
@enduml