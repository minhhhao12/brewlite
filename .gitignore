# ==========================================
# Node.js & Dependencies
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
package-lock.json
# Bỏ comment dòng bên dưới nếu dự án dùng Yarn / pnpm Lockfile thay vì Lockfile cố định
# yarn.lock
# pnpm-lock.yaml

# Local environment variables (Bảo mật thông tin API key, DB password, secret key)
.env
.env.*
!.env.example

# Cache & Temporary files
.eslintcache
.stylelintcache
*.tsbuildinfo
.node_repl_history

# ==========================================
# Next.js (Frontend)
# ==========================================
.next/
out/
build/
dist/

# Next.js Bundle Analyzer
.next-boost/

# Vercel
.vercel

