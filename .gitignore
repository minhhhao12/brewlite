.telemetry

# ==========================================
# NestJS (Backend)
# ==========================================
/dist
/build
/coverage
*.pid
*.seed
*.pid.lock

# NestJS Framework CLI cache
.nest/

# ==========================================
# PostgreSQL & Database local files
# ==========================================
# Dữ liệu Postgres mount ra máy host (nếu bạn không dùng Docker Named Volumes)
pgdata/
postgres-data/
*.sql
*.sqlite
*.dump

# Prisma / TypeORM / Drizzle generated files & migration logs (nếu có)
/prisma/migrations/*.sql.bak
# Migration SQL của Prisma phải được commit
!apps/api/prisma/migrations/**/*.sql

# ==========================================
# Docker & Container Files
# ==========================================
# Ngoại trừ các Dockerfile và docker-compose tiêu chuẩn
# (giữ .dockerignore trong repo để Docker build nhanh và nhất quán)

# Temporary Docker volume mounts
.docker/

