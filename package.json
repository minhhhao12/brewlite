{
  "name": "brewlite",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "dev:api": "pnpm --filter @brewlite/api start:dev",
    "dev:web": "pnpm --filter @brewlite/web dev",
    "prisma:generate": "pnpm --filter @brewlite/api prisma:generate",
    "prisma:migrate": "pnpm --filter @brewlite/api prisma:migrate"
  }
}
